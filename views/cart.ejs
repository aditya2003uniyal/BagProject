<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-gray-100 px-10 py-10">

    <h1 class="text-2xl font-bold mb-6">Your Cart 🛒</h1>

    <!-- FLASH -->
    <% if (success && success.length > 0) { %>
        <div class="bg-green-500 text-white px-4 py-2 rounded mb-4">
            <%= success %>
        </div>
    <% } %>

    <% if (error && error.length > 0) { %>
        <div class="bg-red-500 text-white px-4 py-2 rounded mb-4">
            <%= error %>
        </div>
    <% } %>

    <div class="flex gap-6">

        <!-- LEFT CART ITEMS -->
        <div class="w-[70%]">

            <% if (!cart || cart.length === 0) { %>
                <p class="text-gray-600">Cart is empty</p>
            <% } else { %>

                <% cart.forEach(function(item){ %>

                    <div class="bg-white p-4 mb-4 rounded shadow flex items-center justify-between">

                        <!-- IMAGE + INFO -->
                        <div class="flex items-center gap-4">

                            <!-- ✅ BUFFER IMAGE FIX (BASE64) -->
                            <img 
                                src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>"
                                class="w-20 h-20 object-cover rounded"
                            >

                            <div>
                                <h2 class="font-semibold">
                                    <%= item.product.name %>
                                </h2>

                                <p class="text-gray-700">
                                    ₹<%= item.product.price %>
                                </p>
                            </div>

                        </div>

                        <!-- QUANTITY -->
                        <div class="flex items-center gap-3">

                            <a href="/users/decrease/<%= item.product._id %>"
                               class="bg-red-500 text-white px-3 py-1 rounded">-</a>

                            <span><%= item.quantity %></span>

                            <a href="/users/increase/<%= item.product._id %>"
                               class="bg-green-500 text-white px-3 py-1 rounded">+</a>

                        </div>

                        <!-- REMOVE -->
                        <a href="/users/remove/<%= item.product._id %>"
                           class="text-red-500">Remove</a>

                    </div>

                <% }) %>

            <% } %>

        </div>

        <!-- RIGHT PRICE BOX -->
        <div class="w-[30%] bg-white p-4 rounded shadow h-fit">

            <h2 class="text-lg font-semibold mb-4">Price Breakdown</h2>

            <%
                let total = 0;

                cart.forEach(item => {
                    total += item.product.price * item.quantity;
                });

                let discount = total * 0.10;        // 10% discount
                let platformFee = 20;
                let shipping = total > 500 ? 0 : 40;
                let finalTotal = total - discount + platformFee + shipping;
            %>

            <div class="flex justify-between mb-2">
                <span>Total MRP</span>
                <span>₹<%= total %></span>
            </div>

            <div class="flex justify-between mb-2">
                <span>Discount (10%)</span>
                <span class="text-green-600">- ₹<%= discount.toFixed(0) %></span>
            </div>

            <div class="flex justify-between mb-2">
                <span>Platform Fee</span>
                <span>₹<%= platformFee %></span>
            </div>

            <div class="flex justify-between mb-2">
                <span>Shipping</span>
                <span>
                    <%= shipping === 0 ? "FREE" : "₹" + shipping %>
                </span>
            </div>

            <hr class="my-2">

            <div class="flex justify-between font-bold">
                <span>Total</span>
                <span class="text-green-600">
                    ₹<%= finalTotal.toFixed(0) %>
                </span>
            </div>

        </div>

    </div>

</div>