<%- include('./partials/header') %>

<div class="w-full min-h-screen flex items-start px-20 py-20 bg-gray-100">

    <!-- LEFT SIDEBAR -->
    <div class="w-[25%] flex flex-col items-start">

        <!-- SORT -->
        <div class="flex items-center gap-2">
            <h3 class="font-semibold text-gray-700">Sort by</h3>

            <form action="/users/shop" method="GET">
                <select class="border px-2 py-1 rounded text-sm" name="sortby" onchange="this.form.submit()">
                    <option value="">Select</option>
                    <option value="popular">Popular</option>
                    <option value="newest">Newest</option>
                    <option value="low">Price Low to High</option>
                    <option value="high">Price High to Low</option>
                </select>
            </form>
        </div>

        <!-- LINKS -->
        <div class="flex flex-col mt-20 text-gray-700 text-sm">

            <a class="block w-fit mb-2 hover:underline" href="/users/shop?new=true">
                New Collection
            </a>

            <a class="block w-fit mb-2 hover:underline" href="/users/shop">
                All Products
            </a>

            <a class="block w-fit mb-2 hover:underline" href="/users/shop?discount=true">
                Discounted Products
            </a>

        </div>

        <!-- FILTER -->
        <div class="mt-32 text-gray-700 text-sm">

            <h4 class="font-semibold mb-2">Filter by :</h4>

            <a class="block w-fit mb-2 hover:underline" href="/users/shop?available=true">
                Availability
            </a>

            <a class="block w-fit mb-2 hover:underline" href="/users/shop?discount=true">
                Discount
            </a>

        </div>

    </div>

    <!-- PRODUCT GRID -->
    <div class="w-[75%]">

        <% if(products && products.length > 0){ %>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                <% products.forEach(function(product){ %>

                    <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">

                        <!-- IMAGE -->
                        <div
                            class="w-full h-56 flex items-center justify-center"
                            style="background-color:<%= product.bgcolor %>">

                            <img
                                class="h-40 object-contain"
                                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                alt="<%= product.name %>">
                        </div>

                        <!-- DETAILS -->
                        <div
                            class="p-4"
                            style="background-color:<%= product.pannelcolor %>; color:<%= product.textcolor %>">

                            <h3 class="text-lg font-bold">
                                <%= product.name %>
                            </h3>

                            <div class="mt-4 flex items-center justify-between">

                                <span class="bg-black text-white text-sm font-semibold px-3 py-1 rounded-full">
                                    ₹ <%= product.price %>
                                </span>

                                <a
                                    href="/users/addtocart/<%= product._id %>"
                                    class="flex items-center gap-1 bg-white text-black border border-gray-300 px-3 py-1 rounded-full text-sm font-medium hover:bg-gray-100 transition">

                                    <i class="ri-add-line"></i>
                                    Add
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="text-center py-20">
                <h2 class="text-2xl font-semibold text-gray-600">
                    No Products Found
                </h2>
            </div>

        <% } %>

    </div>

</div>

<%- include('./partials/footer') %>